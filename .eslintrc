{
    "env": {
      "commonjs": true,
      "node": true,
      "browser": true,
      "es6": true,
      "jest": true
    },
      "extends": ["prettier"],
      "plugins": ["prettier"],
      "parser": "@babel/eslint-parser",
      "parserOptions": {
        "sourceType": "module"
      },
      "rules": {
        "prettier/prettier": ["error"]
      }
    }